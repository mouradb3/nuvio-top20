# Required
TMDB_API_KEY=

# Optional: Trakt history/recommendations
TRAKT_CLIENT_ID=
TRAKT_ACCESS_TOKEN=
TRAKT_USERNAME=

# Optional: OpenAI-compatible AI recommendations
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini

# Server
PORT=7000
CACHE_MINUTES=30

# Exclude Indian-origin productions from France release catalogs
EXCLUDE_INDIA=true
